            <key>escaping</key><integer>102</integer>
            <key>script</key><string>#!/bin/bash
delta="${1#+}"

if ! [[ "$delta" =~ ^[0-9]+$ ]]; then
    exit 1
fi

current=$(/usr/bin/osascript -e 'output volume of (get volume settings)')
target=$((current + delta))

if (( target > 100 )); then
    target=100
fi

/usr/bin/osascript -e "set volume output volume $target"
printf '%s' "$1"
